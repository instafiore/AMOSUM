# Unit tests of amoclingo-core (the C++ sources in amosum/ and amosum/amoclingo/cpp/, on fiore).
#
#   make test                         debug (asserts and LOG on) and release (-O3 -DNDEBUG)
#   make run [BUILD_MODE=release] [FILTER=progression]   build and run one mode, optionally only matching tests
#   make data                         rewrite ../data/*.asp into ../data/*.lp with the amosum parser (needs Python)
#   make clean

REPO := $(abspath ../../..)
include $(REPO)/fiore/fiore.mk

CXX ?= c++
CLINGO_INC = -I/opt/homebrew/include
CLINGO_LIB = -L/opt/homebrew/lib -Wl,-rpath,/opt/homebrew/lib
ifneq ($(CONDA_PREFIX),)
    CLINGO_INC += -I$(CONDA_PREFIX)/include
    CLINGO_LIB += -L$(CONDA_PREFIX)/lib -Wl,-rpath,$(CONDA_PREFIX)/lib
endif

BUILD_MODE ?= debug
ifeq ($(BUILD_MODE), debug)
    MODE_FLAGS = -g -O1
else
    MODE_FLAGS = -O3 -DNDEBUG
endif

CXXFLAGS = -std=c++20 -Wall -Wextra -Wno-unused-parameter -Wno-missing-field-initializers -Wno-unused-variable \
           -Wno-unused-but-set-variable -Wno-comment -Wno-macro-redefined $(MODE_FLAGS) \
           $(FIORE_CPPFLAGS) $(CLINGO_INC) -DDATA_DIR='"$(abspath ../data)"'
OUT = build/$(BUILD_MODE)

# amoclingo-core without its main (amoclingo.cpp), fiore, and the tests (test_main.cpp has the main)
AMOSUM_SRCS = $(wildcard $(REPO)/amosum/*.cpp) $(filter-out %/amoclingo.cpp,$(wildcard $(REPO)/amosum/amoclingo/cpp/*.cpp))
TEST_SRCS   = $(wildcard *.cpp)
OBJS = $(patsubst $(REPO)/%.cpp,$(OUT)/obj/%.o,$(AMOSUM_SRCS) $(FIORE_SRCS)) $(TEST_SRCS:%.cpp=$(OUT)/test/%.o)

.PHONY: test run data clean

test:
	@$(MAKE) --no-print-directory BUILD_MODE=debug run
	@$(MAKE) --no-print-directory BUILD_MODE=release run

run: $(OUT)/unit_tests
	@echo "== $(BUILD_MODE)"
	@$(OUT)/unit_tests $(OUT) $(FILTER)

$(OUT)/unit_tests: $(OBJS)
	$(CXX) $^ $(CLINGO_LIB) -lclingo -o $@

$(OUT)/obj/%.o: $(REPO)/%.cpp
	@mkdir -p $(dir $@)
	$(CXX) $(CXXFLAGS) -MMD -MP -c $< -o $@

$(OUT)/test/%.o: %.cpp
	@mkdir -p $(dir $@)
	$(CXX) $(CXXFLAGS) -MMD -MP -c $< -o $@

# header dependencies (-MMD): a changed header recompiles the files that include it
-include $(OBJS:.o=.d)

PYTHON ?= python
data:
	@for f in ../data/*.asp; do \
	    { echo "% generated by the amosum parser from $$(basename $$f) (make data): do not edit"; \
	      cd $(REPO) && $(PYTHON) -O -m amosum.amosum_parser < $(abspath .)/$$f; } > $${f%.asp}.lp || exit 1; \
	    echo "$$f -> $${f%.asp}.lp"; \
	done

clean:
	rm -rf build
