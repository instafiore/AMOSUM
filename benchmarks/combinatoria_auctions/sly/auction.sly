Problem:auction
	Data
		int num_items;
		int num_bids;
		int max_item;
		int index_packages[num_bids+1];
		int tn_packages;
		int packages[tn_packages];
		int bids[num_bids];
		int totalbid;

	Domains
		Dom zerou=[0..1];

	Variables
		IntVar x[num_bids]::zerou;
		%IntVar total::int;
		%IntVar objectiu::int;
	Constraints

		Forall(j in [1..num_items]) {
			sum1([x[i] |  i in [1..num_bids] , 
				Exists(k in [index_packages[i]..index_packages[i+1]-1])
				{
					packages[k]=j;
				}
			] ) =<1;
		};

		Forall(i in [1..num_bids]) {
			x[i]=1 @ {bids[i]};
		};
		

